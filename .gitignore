# Build output — the source is what belongs in this repo; the binaries ship in
# the Releases as a ready-to-run folder.
dist/
obj/
bin/
*.elf
*.zip

# Generated at build time (regenerated by `make` / `dotnet publish`)
include/file_registry.c
include/file_registry.h
include/assets_*.h
include/wkali_version.h
*.stamp
installer.elf
pldmgr.elf

# Submodules / vendored checkouts: referenced via .gitmodules, not committed
third_party/

# Frontend build output (npm run build regenerates it)
frontend/dist/
frontend/node_modules/
node_modules/

# Backups and editor noise
_backup/
.vs/
.idea/
*.bak
*.bak-*
*~
.DS_Store
Thumbs.db
