<Window x:Class="Pyre.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PYRE"
        Width="1010" Height="800" MinWidth="880" MinHeight="620"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource Sans}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <!-- the site's own backdrop: radial ember glow over charcoal -->
    <Grid.Background>
      <RadialGradientBrush Center="0.5,0.16" GradientOrigin="0.5,0.16" RadiusX="0.85" RadiusY="0.75">
        <GradientStop Color="#3A1706" Offset="0"/>
        <GradientStop Color="#0C0A09" Offset="0.62"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================================================= header -->
    <StackPanel Grid.Row="0" Margin="34,22,34,2">
      <TextBlock x:Name="EyebrowText"
                 FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Flame}"
                 Margin="0,0,0,6"/>
      <TextBlock x:Name="TitleText"
                 FontFamily="{StaticResource Mono}" FontSize="38" Foreground="{StaticResource Ember}">
        <TextBlock.Effect>
          <DropShadowEffect Color="#FF7A18" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        </TextBlock.Effect>
      </TextBlock>
      <TextBlock x:Name="TaglineText"
                 FontSize="13" Foreground="#E6CBB4" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- ==================================================== body: five tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="34,10,28,0">

      <!-- ===== HOST -->
      <TabItem x:Name="TabHost">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,16">
          <StackPanel>

            <!-- prominent failure: the site is not next to the exe -->
            <Border x:Name="SiteErrorBanner" Visibility="Collapsed"
                    Background="#2A0F0D" BorderBrush="{StaticResource Bad}" BorderThickness="1"
                    CornerRadius="7" Padding="16,14" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock x:Name="SiteErrorTitle" FontFamily="{StaticResource Mono}" FontSize="14"
                           Foreground="#FFB4AD" TextWrapping="Wrap"/>
                <TextBlock x:Name="SiteErrorBody" FontSize="12.5" Foreground="#E7C9C4"
                           TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
              </StackPanel>
            </Border>

            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="HostCardTitle" DockPanel.Dock="Left" Style="{StaticResource CardTitle}"
                             VerticalAlignment="Center"/>
                  <Border x:Name="StatusPill" DockPanel.Dock="Right" CornerRadius="4" BorderThickness="1"
                          BorderBrush="{StaticResource Line}" Background="#1A1009" Padding="10,4">
                    <TextBlock x:Name="StatusText" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource Ash}"/>
                  </Border>
                </DockPanel>
                <TextBlock x:Name="HostCardHint" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <Grid Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock x:Name="IpLabel" Style="{StaticResource Small}"/>
                    <Button x:Name="IpButton" Style="{StaticResource BigNumberButton}"
                            HorizontalAlignment="Left" Margin="-10,4,0,0" Click="OnCopyIp"/>
                    <TextBlock x:Name="IpSourceText" Style="{StaticResource Small}"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,10,0,0">
                    <Button x:Name="IpCopyButton" Style="{StaticResource SmallButton}" Click="OnCopyIp"/>
                    <Button x:Name="IpRefreshButton" Style="{StaticResource SmallGhostButton}"
                            Click="OnRefreshIp" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="UrlLabel" Style="{StaticResource Small}" Margin="0,16,0,0"/>
                <DockPanel Margin="0,6,0,0">
                  <Button x:Name="UrlCopyButton" DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}"
                          Click="OnCopyUrl" Margin="8,0,0,0"/>
                  <TextBox x:Name="UrlBox" Style="{StaticResource UrlBox}"/>
                </DockPanel>

                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="OnStartStop"/>

                <TextBlock x:Name="RootText" Style="{StaticResource Small}"
                           Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBlock x:Name="PayloadText" Style="{StaticResource Small}"
                           Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>

                <TextBlock x:Name="BootstrapText" Style="{StaticResource Small}"
                           Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
              </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="FirewallCardTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="FirewallHint" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="FirewallDot" Grid.Column="0" Width="9" Height="9"
                           Fill="{StaticResource Ash}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock x:Name="FirewallStatusText" Grid.Column="1" FontFamily="{StaticResource Mono}"
                             FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                  <Button x:Name="FirewallButton" Grid.Column="2" Style="{StaticResource SmallGhostButton}"
                          Click="OnFirewallButton" Margin="12,0,0,0"/>
                </Grid>

                <TextBlock x:Name="FirewallNoteText" Style="{StaticResource Small}"
                           Foreground="{StaticResource Warn}" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="FirewallAdminNote" Style="{StaticResource Small}"
                           Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
              </StackPanel>
            </ContentControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== JAILBREAK -->
      <TabItem x:Name="TabJailbreak">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,16">
          <StackPanel>
            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="HowToCardTitle" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="InstructionsList" Margin="0,16,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="{StaticResource Mono}"
                                   FontSize="13" Foreground="{StaticResource Ember}" MinWidth="36"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5"
                                   Foreground="#ECD9C8" TextWrapping="Wrap" LineHeight="21"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="Ps5Button" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Click="OnShowPs5"/>
              </StackPanel>
            </ContentControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== PAYLOADS -->
      <TabItem x:Name="TabPayloads">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,16">
          <StackPanel>
            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="PayloadsCardTitle" DockPanel.Dock="Left" Style="{StaticResource CardTitle}"
                             VerticalAlignment="Center"/>
                  <Border x:Name="PayloadsPill" DockPanel.Dock="Right" CornerRadius="4" BorderThickness="1"
                          BorderBrush="{StaticResource Line}" Background="#1A1009" Padding="10,4">
                    <TextBlock x:Name="PayloadsPillText" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource Ash}"/>
                  </Border>
                </DockPanel>
                <TextBlock x:Name="PayloadsHint" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <!-- one row per payload: path, size, and found/missing -->
                <ItemsControl x:Name="PayloadsList" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Dot}"
                                 VerticalAlignment="Center" Margin="0,0,11,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="{StaticResource Mono}"
                                   FontSize="12" Foreground="{Binding Tint}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontFamily="{StaticResource Mono}"
                                   FontSize="11.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ContentControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== EMULATION -->
      <TabItem x:Name="TabEmulation">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,16">
          <StackPanel>

            <TextBlock x:Name="EmulationIntro" Style="{StaticResource Body}" Margin="2,0,0,14"/>

            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="EmuRetroTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="EmuRetroIntro" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <ItemsControl x:Name="EmuRetroList" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"
                                   Foreground="{StaticResource Flame}" MinWidth="118"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}"
                                   FontSize="12.5" Foreground="{StaticResource Ink}"
                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmuSystemsLabel" Style="{StaticResource Small}"
                           Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                <ItemsControl x:Name="EmuSystemsList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12"
                                 Foreground="{StaticResource Ash}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="EmuProsperoTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="EmuProsperoIntro" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <ItemsControl x:Name="EmuProsperoList" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5"
                                   Foreground="{StaticResource Flame}" MinWidth="118"
                                   VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}"
                                   FontSize="12.5" Foreground="{StaticResource Ink}"
                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ContentControl>

            <TextBlock x:Name="EmulationNote" Style="{StaticResource Small}"
                       Foreground="{StaticResource Muted}" Margin="2,0,0,10"/>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== LOG -->
      <TabItem x:Name="TabLog">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,16">
          <StackPanel>
            <ContentControl Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="LogCardTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="LogHint" Style="{StaticResource Small}" Margin="0,8,0,0"/>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="LogRequestsCheck" Grid.Column="0" VerticalAlignment="Center"
                            Checked="OnLogRequestsToggled" Unchecked="OnLogRequestsToggled"/>
                  <Button x:Name="LogClearButton" Grid.Column="1" Style="{StaticResource SmallGhostButton}"
                          Click="OnClearLog"/>
                </Grid>

                <ScrollViewer x:Name="LogScroll" Height="380" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}"
                              BorderThickness="1" Margin="0,10,0,0" Padding="10,8">
                  <ItemsControl x:Name="LogList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                   Foreground="{StaticResource Ash}" TextWrapping="NoWrap"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </ContentControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- ================================================= footer -->
    <Border Grid.Row="2" Background="#100B09" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="34,12">
      <Grid>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Left" VerticalAlignment="Center"
                   FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="LangLabel" VerticalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource Ash}" Margin="0,0,10,0"/>
          <ComboBox x:Name="LanguageBox" Width="176" SelectionChanged="OnLanguageChanged"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== PS5 route overlay (written steps, wave 1) -->
    <Grid x:Name="Ps5Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#E60C0A09"
          Visibility="Collapsed">
      <Border MaxWidth="660" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="10" Padding="28"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
        <StackPanel>
          <TextBlock x:Name="Ps5Title" FontFamily="{StaticResource Mono}" FontSize="20"
                     Foreground="{StaticResource Ember}"/>
          <TextBlock x:Name="Ps5Intro" Style="{StaticResource Small}" Margin="0,8,0,0"/>
          <ItemsControl x:Name="Ps5Steps" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="13.5" Foreground="#ECD9C8"
                           TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,10"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="#1B110B" BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                  CornerRadius="5" Padding="14,12" Margin="0,6,0,0">
            <TextBlock x:Name="Ps5Note" Style="{StaticResource Small}" Foreground="{StaticResource Ash}"/>
          </Border>
          <Button x:Name="Ps5CloseButton" Style="{StaticResource SecondaryButton}"
                  HorizontalAlignment="Right" Margin="0,20,0,0" Click="OnClosePs5"/>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
