<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore source for building Pyre.

  This machine's user-level config (%APPDATA%\NuGet\nuget.config) has an EMPTY <packageSources>,
  so `dotnet restore` finds nothing and cannot pull the self-contained runtime packs
  (Microsoft.NETCore.App.Runtime.win-x64, Microsoft.WindowsDesktop.App.Runtime.win-x64).
  That is why this file exists, scoped to this folder only - the user's global config is
  deliberately left alone.

  Offline build: if nuget.org is unreachable, run with
    dotnet publish ... /p:RestoreSources=<path-to-a-local-feed>
  or drop the runtime packs into %USERPROFILE%\.nuget\packages.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
